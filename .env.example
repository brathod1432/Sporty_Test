# Sporty_Test — copy to `.env` and fill in your values. Never commit `.env`.
#   copy .env.example .env   (Windows cmd)
#   cp .env.example .env     (bash)

# --- Required: your server-issued user id ---
# Get it from whoever issued the assignment. Arbitrary values are rejected
# by the API with 401 {"error": "invalid_user_id"}.
# Used as:  browser → ?user-id=<USER_ID>  |  API → header x-user-id: <USER_ID>
USER_ID=paste-your-user-id-here

# --- App + API locations (change only if the deployment moves) ---
BASE_URL=https://qae-assignment-tau.vercel.app
APP_URL=https://qae-assignment-tau.vercel.app/?user-id=${USER_ID}
API_DOCS_URL=https://qae-assignment-tau.vercel.app/api/docs

# --- Optional test knobs ---
# Default stake used by example tests (must stay within 1.00 – 100.00 EUR).
DEFAULT_STAKE=10
# Request timeout in seconds for libs/rest_helper.py calls.
REQUEST_TIMEOUT=30
